#include <winver.h>

1 ICON "pairdesk.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PD_VERSION_NUM
PRODUCTVERSION PD_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Sandun Madhushan"
      VALUE "FileDescription", "PairDesk"
      VALUE "FileVersion", PD_VERSION_STR
      VALUE "InternalName", "pairdesk-agent"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "pairdesk-agent.exe"
      VALUE "ProductName", "PairDesk"
      VALUE "ProductVersion", PD_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
